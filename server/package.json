{
  "name": "@ehealth/server",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS Backend API for E-Healthcare Portal",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.5",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "google-auth-library": "^10.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.0",
    "redis": "^5.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "jest-util": "^30.0.0",
    "js-tokens": "^4.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.5.2"
  },
  "engines": {
    "node": ">=20"
  }
}
