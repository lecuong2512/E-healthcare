{
  "name": "e-healthcare",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống Quản lý & Đặt lịch Khám chữa bệnh (E-Healthcare Portal) - Monorepo",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
