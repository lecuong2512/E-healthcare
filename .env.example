# ==========================================
# E-HEALTHCARE PORTAL - CÁC BIẾN MÔI TRƯỜNG
# ==========================================

# --- Môi trường chạy ứng dụng ---
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- Cơ sở dữ liệu PostgreSQL (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ehealth_db
POSTGRES_PORT=5432
POSTGRES_IMAGE_TAG=16-alpine

# --- Redis Stack: bộ nhớ đệm và khóa phân tán ---
# Để trống khi phát triển local cho RedisInsight kết nối; cấu hình khi chạy staging/production.
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=localhost
# Tùy chọn thay REDIS_HOST/REDIS_PORT/REDIS_PASSWORD bằng một URL đầy đủ.
REDIS_URL=
REDIS_INSIGHT_PORT=8001
REDIS_IMAGE_TAG=7.2.0-v10

# --- Nginx: proxy ngược và cổng SSL ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Xác thực và JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QR_CHECKIN_SECRET=
QUEUE_BOARD_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# true mặc định. Chỉ đặt false khi phát triển bằng HTTP local; production bắt buộc true.
COOKIE_SECURE=true

# --- API đăng ký (SRS-AUTH-01) ---
PORT=3000
# IP/CIDR của cổng Nginx tin cậy, phân tách bằng dấu phẩy; để trống khi truy cập trực tiếp.
TRUSTED_PROXY_CIDRS=
# API runtime credential: non-superuser/non-owner with least privilege.
DATABASE_URL=postgresql://ehealth_app_runtime:replace_me@localhost:5432/ehealth_db
# Migration-only owner credential. Never expose this URL to the API runtime.
DATABASE_MIGRATION_URL=postgresql://ehealth_migrator:replace_me@localhost:5432/ehealth_db
# Auto-enabled when NODE_ENV=staging/production; set true to verify privileges locally.
ENFORCE_RUNTIME_DB_ROLE=false
# REQUIRED: API fails fast without this value. Use exactly 64 random hexadecimal characters.
# Generate a local-only key, copy it to .env and keep the same key for existing encrypted data.
# Never commit or send a real key through source control/chat.
MEDICAL_DATA_ENCRYPTION_KEY=
MEDICAL_DATA_ENCRYPTION_KEY_VERSION=1
# Optional JSON keyring for decrypting older rows during rotation, e.g. {"1":"<64-hex>"}.
MEDICAL_DATA_ENCRYPTION_KEYS_JSON=
# pgBackRest repository encryption. Generate a separate secret; never reuse the medical-data key.
PGBACKREST_REPO_CIPHER_PASS=
PGBACKREST_RETENTION_FULL=7
PGBACKREST_PROCESS_MAX=2
# Evaluated with TZ=Asia/Ho_Chi_Minh by the infrastructure scheduler.
EHEALTH_BACKUP_FULL_TIME=02:00
EHEALTH_BACKUP_RUN_FULL_ON_START=false
# Tạo khóa bí mật ngẫu nhiên ít nhất 32 byte; không sử dụng giá trị mặc định.
OTP_HMAC_SECRET=
# Gửi Email qua SMTP; dùng công cụ nhận thư local khi phát triển.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Reminder scheduler uses this business timezone and can be disabled without changing code.
APPOINTMENT_REMINDERS_ENABLED=true
APPOINTMENT_REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
# Bộ gửi SMS: POST {phoneNumber, message, brandName?}, xác thực Bearer; mã 2xx nghĩa là provider chấp nhận gửi.
# Production yêu cầu HTTPS. Cấu hình cổng SMS theo định dạng này.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_BRAND_NAME=

# Prescription PDFs use the bundled Noto Sans font; configure the public HTTPS app origin.
PRESCRIPTION_VERIFICATION_BASE_URL=

# --- Đăng nhập Google OAuth 2.0 / OpenID Connect ---
# Tạo OAuth client loại Web Application trên Google Cloud và khai báo URI callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/api/v1/auth/google/callback
FRONTEND_URL=https://localhost

# Reception receipt printing (name and address are required for print only).
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_TAX_CODE=
CLINIC_LICENSE_NUMBER=
CLINIC_LOGO_URL=
