# ==========================================
# E-HEALTHCARE PORTAL - ENVIRONMENT VARIABLES
# ==========================================

# --- Application Runtime ---
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- PostgreSQL Database (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ehealth_db
POSTGRES_PORT=5432
POSTGRES_IMAGE_TAG=16-alpine

# --- Redis Stack In-Memory & Distributed Lock ---
# Left empty for local development (seamless RedisInsight connection); set in staging/production
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_IMAGE_TAG=7.2.0-v10

# --- Nginx Reverse Proxy & SSL Gateway ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Authentication & JWT ---
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
